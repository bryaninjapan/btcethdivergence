{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btcethdivergence",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "btcethdivergence",
      "database_id": "8c4a6c69-7998-4897-b4bf-89191ff0f245"
    }
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "btcethdivergence.bryanlab.cc/*",
      "zone_name": "bryanlab.cc"
    }
  ]
}
