import math, time
now = int(time.time())
start = now - 720*3600
lines = []
for s, base in [("BTCUSDT", 60000.0), ("ETHUSDT", 3000.0)]:
    for i in range(720):
        t = start + i*3600
        o = base * (1 + 0.001*math.sin(i/40))
        c = base * (1 + 0.001*math.sin((i+1)/40))
        h = max(o, c)*1.002
        l = min(o, c)*0.998
        lines.append(f"INSERT INTO klines (symbol, open_time, open, high, low, close, volume) VALUES ({chr(39)}{s}{chr(39)}, {t}, {o:.2f}, {h:.2f}, {l:.2f}, {c:.2f}, 100.5);")
with open("/var/folders/9h/53xqxyrs1m3_hkd64_sfvybm0000gn/T/opencode/seed-klines2.sql", "w") as f:
    f.write("\n".join(lines))
print("now:", now, "start:", start, "max:", start+719*3600)
'
