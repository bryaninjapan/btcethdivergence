import { test, expect } from '@playwright/test';

test('debug chart state', async ({ page }) => {
  await page.goto('/charts.html');
  await page.waitForSelector('canvas', { timeout: 5000 });
  await page.waitForTimeout(1500);
  const info = await page.evaluate(() => {
    const w = window as any;
    const btc = w.__test_charts?.btcChart;
    const eth = w.__test_charts?.ethChart;
    const bts = btc?.timeScale();
    const ets = eth?.timeScale();
    return {
      btcExists: !!btc,
      ethExists: !!eth,
      btcVisibleRange: bts?.getVisibleRange ? bts.getVisibleRange() : 'no-method',
      ethVisibleRange: ets?.getVisibleRange ? ets.getVisibleRange() : 'no-method',
      btcLogical: bts?.getVisibleLogicalRange ? bts.getVisibleLogicalRange() : 'no-method',
      ethLogical: ets?.getVisibleLogicalRange ? ets.getVisibleLogicalRange() : 'no-method',
      errorText: document.getElementById('chart-error')?.textContent,
      errorHidden: (document.getElementById('chart-error') as HTMLElement)?.hidden,
    };
  });
  console.log('DEBUG INFO:', JSON.stringify(info, null, 2));
  expect(true).toBe(true);
});
