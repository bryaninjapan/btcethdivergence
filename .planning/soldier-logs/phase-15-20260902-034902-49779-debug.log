import { test, expect } from '@playwright/test';

test('debug chart state v2', async ({ page }) => {
  await page.goto('/charts.html');
  await page.waitForSelector('canvas', { timeout: 5000 });
  await page.waitForTimeout(1500);
  const info = await page.evaluate(async () => {
    const w = window as any;
    const btcSeries = w.__test_charts?.btcSeries;
    let seriesDataCount = 'no-series';
    if (btcSeries) {
      try { seriesDataCount = btcSeries.data ? btcSeries.data().length : 'no-data-method'; }
      catch (e) { seriesDataCount = 'error: ' + (e as Error).message; }
    }
    const managerInfo = (w as any).__chart_manager_debug || 'no-manager-debug';
    return { seriesDataCount };
  });
  console.log('DEBUG2:', JSON.stringify(info));
  expect(true).toBe(true);
});
