import { test, expect } from '@playwright/test';

test('debug network + load', async ({ page }) => {
  const klinesResponses: any[] = [];
  page.on('response', async (res) => {
    if (res.url().includes('/api/klines')) {
      try {
        const body = await res.json();
        klinesResponses.push({ url: res.url(), status: res.status(), count: body?.data?.length, ok: body?.ok });
      } catch (e) { klinesResponses.push({ url: res.url(), status: res.status(), err: String(e) }); }
    }
  });
  page.on('console', (msg) => { if (msg.type() === 'error') console.log('PAGE ERROR:', msg.text()); });
  page.on('pageerror', (err) => console.log('PAGE ERROR EVENT:', err.message));
  await page.goto('/charts.html');
  await page.waitForSelector('canvas', { timeout: 5000 });
  await page.waitForTimeout(2500);
  const info = await page.evaluate(() => {
    const w = window as any;
    const loading = document.getElementById('chart-loading') as HTMLElement;
    const error = document.getElementById('chart-error') as HTMLElement;
    return {
      loadingHidden: loading?.hidden,
      errorHidden: error?.hidden,
      errorText: error?.textContent,
      rangeSummary: document.getElementById('range-summary')?.textContent,
      hasManagerChart: !!w.__test_charts?.btcChart,
    };
  });
  console.log('DEBUG3 INFO:', JSON.stringify(info));
  console.log('DEBUG3 KLINES RESPONSES:', JSON.stringify(klinesResponses));
  expect(true).toBe(true);
});
EOF
