const fs = require("fs");
const now = Math.floor(Date.now()/1000);
const start = now - 720*3600;
const rows = [];
for (let s of ["BTCUSDT","ETHUSDT"]) {
  let base = s === "BTCUSDT" ? 60000 : 3000;
  for (let i=0;i<720;i++) {
    const t = start + i*3600;
    const o = base * (1 + 0.001*Math.sin(i/40));
    const c = base * (1 + 0.001*Math.sin((i+1)/40));
    const h = Math.max(o,c)*1.002;
    const l = Math.min(o,c)*0.998;
    rows.push(`INSERT INTO klines (symbol, open_time, open, high, low, close, volume) VALUES ('${s}', ${t}, ${o.toFixed(2)}, ${h.toFixed(2)}, ${l.toFixed(2)}, ${c.toFixed(2)}, 100.5);`);
  }
}
fs.writeFileSync("/var/folders/9h/53xqxyrs1m3_hkd64_sfvybm0000gn/T/opencode/seed-klines.sql", rows.join("\n"));
console.log("wrote", rows.length, "rows");
'
