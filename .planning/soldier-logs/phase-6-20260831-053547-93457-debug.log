fetch-binance.yml
name: Fetch Binance Klines (Backfill)

on:
  workflow_dispatch:
    inputs:
      symbol:
        description: Trading pair to backfill
        type: choice
        options:
          - BTCUSDT
          - ETHUSDT
        default: BTCUSDT
      start_time_override:
        description: Optional startTime in ms (testing only)
        type: string
        required: false
        default: ''

jobs:
  backfill:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install dependencies
        run: npm ci

      - name: Run backfill fetcher
        run: npx tsx scripts/backfill-fetcher.mts
        env:
          WORKER_URL: ${{ secrets.WORKER_URL }}
          INGEST_TOKEN: ${{ secrets.INGEST_TOKEN }}
          SYMBOL: ${{ inputs.symbol }}
          START_TIME_OVERRIDE: ${{ inputs.start_time_override }}

      - name: Notify on failure
        if: failure()
        run: echo "backfill run failed"
