{
  "name": "btcethdivergence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BTC/ETH divergence tracker — single Cloudflare Worker (Static Assets binding) + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --project scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
---
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btcethdivergence",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "btcethdivergence",
      "database_id": "8c4a6c69-7998-4897-b4bf-89191ff0f245"
    }
  ]
}
