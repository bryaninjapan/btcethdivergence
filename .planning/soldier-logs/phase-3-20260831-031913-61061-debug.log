import json, urllib.request, datetime

def utc_ms(s):
    return int(datetime.datetime.strptime(s,'%Y-%m-%d %H:%M').replace(tzinfo=datetime.timezone.utc).timestamp()*1000)

windows = [
    ('2021-02-11 03:00','2021-02-11 06:00'),
    ('2021-03-06 02:00','2021-03-06 04:00'),
    ('2021-04-20 01:00','2021-04-20 05:00'),
    ('2021-04-25 04:00','2021-04-25 09:00'),
    ('2021-08-13 01:00','2021-08-13 07:00'),
    ('2021-09-29 06:00','2021-09-29 10:00'),
    ('2023-03-24 12:00','2023-03-24 15:00'),
]
for start,end in windows:
    url=f'https://api.binance.com/api/v3/klines?symbol=BTCUSDT&interval=1h&startTime={utc_ms(start)}&endTime={utc_ms(end)}&limit=1000'
    with urllib.request.urlopen(url) as r:
        data=json.load(r)
    opens=[datetime.datetime.fromtimestamp(k[0]/1000, tz=datetime.timezone.utc).strftime('%H:%M') for k in data]
    print(f'{start} -> {end}: Binance returns {len(data)} candles at hours {opens}')
