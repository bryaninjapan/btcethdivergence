commit 83205ec792cff3294a32f8d3fc3ee08899eb7c75
Author: bryaninjapan <paperworkbybryan@gmail.com>
Date:   Thu Sep 3 08:59:45 2026 +0900

    test(16-fix-1): add msb:'yes' partial-PUT regression test
    
    Seed a record with msb:'yes', perform a partial PUT that omits msb, and assert msb
    remains 'yes'. This regression test catches the Zod v4 .partial() default injection bug
    that was masking the HIGH issue.
    
    Co-Authored-By: Claude Haiku 4.5 <noreply@anthropic.com>

 src/services/RecordsRepository.test.ts | 11 +++++++++++
 1 file changed, 11 insertions(+)
===DIFF===
diff --git a/src/services/RecordsRepository.test.ts b/src/services/RecordsRepository.test.ts
index 8476129..62403a5 100644
--- a/src/services/RecordsRepository.test.ts
+++ b/src/services/RecordsRepository.test.ts
@@ -196,6 +196,17 @@ describe('RecordsRepository.update', () => {
       message: expect.stringContaining('Failed to update record'),
     });
   });
+
+  it('preserves msb:yes on partial update (regression: HIGH msb default bug)', async () => {
+    const recordWithMsbYes: DivergenceRecord = { ...EXISTING, msb: 'yes' };
+    const db = createMockD1WithData({ divergence_records: [recordWithMsbYes] });
+
+    const record = await repo(db).update(1, { type: 'btc_hl_eth_ll' });
+
+    // Critical: msb must stay 'yes', not be reset to 'no' by Zod's .partial() default bug
+    expect(record?.msb).toBe('yes');
+    expect(record?.type).toBe('btc_hl_eth_ll');
+  });
 });
 
