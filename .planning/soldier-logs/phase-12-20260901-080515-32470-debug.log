import { describe, it } from 'vitest';
import { createMockD1WithData } from './lib/test-db';
import { recordsService } from './services/records.service';
import type { DivergenceRecord } from './types';

describe('debug update', () => {
  it('shows raw error', async () => {
    const EXISTING: DivergenceRecord = { id: 1, start_time: 1600000000, end_time: 1600003600, type: 'time_lag', notes: 'existing notes', tags: 'existing tags', created_at: 1, updated_at: 1 };
    const db = createMockD1WithData({ divergence_records: [EXISTING] });
    const { updateRecord } = await import('./lib/db');
    try {
      const r = await updateRecord(db as unknown as D1Database, 1, { type: 'structural' });
      console.log('OK', JSON.stringify(r));
    } catch (e) {
      console.log('RAW ERROR:', (e as Error).message);
      console.log('STACK:', (e as Error).stack);
    }
  });
});
EOF
