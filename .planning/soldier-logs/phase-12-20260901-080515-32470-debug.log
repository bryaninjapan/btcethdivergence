import { describe, it } from 'vitest';

describe('debug location redefine', () => {
  it('can redefine window.location', async () => {
    const d = Object.getOwnPropertyDescriptor(window, 'location');
    console.log('window.location descriptor configurable=', d?.configurable);
    let captured = '';
    const fake = {
      assign: (url: string) => { captured = url; },
    };
    try {
      Object.defineProperty(window, 'location', { value: fake, writable: true, configurable: true });
      window.location.assign('http://x/charts.html?a=1');
      console.log('captured=', captured);
      console.log('SUCCESS');
    } catch (e) {
      console.log('failed:', (e as Error).message);
    }
  });
});
EOF
