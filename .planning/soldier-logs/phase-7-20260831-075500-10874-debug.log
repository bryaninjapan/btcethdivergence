import { chromium } from 'playwright';
const browser = await chromium.launch();
const page = await browser.newPage();
await page.goto('https://btcethdivergence.gn01968711.workers.dev/charts.html', { waitUntil: 'load' });
const r = await page.evaluate(async () => {
  const url = 'https://unpkg.com/lightweight-charts@5.2.1/dist/lightweight-charts.standalone.production.js';
  const attr = (document.querySelector('script[src*="lightweight-charts"]')?.getAttribute('integrity') || '').replace(/^sha384-/, '');
  const buf = new Uint8Array(await (await fetch(url)).arrayBuffer());
  const digest = await crypto.subtle.digest('SHA-384', buf);
  const b64 = btoa(String.fromCharCode(...new Uint8Array(digest)));
  let out = '';
  for (let i = 0; i < Math.max(attr.length, b64.length); i++) {
    const a = attr[i] ?? '·';
    const c = b64[i] ?? '·';
    if (a !== c) out += `idx ${i}: attr='${a}' (${attr.charCodeAt(i)}) computed='${c}'\n`;
  }
  return { attr, computed: b64, diffs: out, attrLen: attr.length, computedLen: b64.length };
});
console.log(r.diffs || 'NO DIFFS');
console.log('attr:', r.attr);
console.log('comp:', r.computed);
await browser.close();
EOF
