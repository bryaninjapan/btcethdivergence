+
+export async function createRecord(db: D1Database, payload: CreateRecordInput): Promise<DivergenceRecord> {
+  const now = Math.floor(Date.now() / 1000);
+  const { results } = await db
+    .prepare(
+      `INSERT INTO divergence_records (start_time, end_time, type, notes, tags, created_at, updated_at)
+       VALUES (?, ?, ?, ?, ?, ?, ?)
+       RETURNING *`,
+    )
+    .bind(payload.start_time, payload.end_time, payload.type, payload.notes, payload.tags, now, now)
+    .all<DivergenceRecord>();
+  return results[0];
+}
+
+export async function updateRecord(
+  db: D1Database,
+  id: number,
+  payload: UpdateRecordInput,
+): Promise<DivergenceRecord | null> {
+  const sets: string[] = [];
+  const values: (string | number)[] = [];
+  if (payload.start_time !== undefined) {
+    sets.push('start_time = ?');
+    values.push(payload.start_time);
+  }
+  if (payload.end_time !== undefined) {
+    sets.push('end_time = ?');
+    values.push(payload.end_time);
+  }
+  if (payload.type !== undefined) {
+    sets.push('type = ?');
+    values.push(payload.type);
+  }
+  if (payload.notes !== undefined) {
+    sets.push('notes = ?');
+    values.push(payload.notes);
+  }
+  if (payload.tags !== undefined) {
+    sets.push('tags = ?');
+    values.push(payload.tags);
+  }
+  const now = Math.floor(Date.now() / 1000);
+  sets.push('updated_at = ?');
+  values.push(now);
+  values.push(id);
+
+  const { results } = await db
+    .prepare(`UPDATE divergence_records SET ${sets.join(', ')} WHERE id = ? RETURNING *`)
+    .bind(...values)
+    .all<DivergenceRecord>();
+  return results[0] ?? null;
 }
